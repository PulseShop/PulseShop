node_modules/
dist/
dev-dist/
*.local

# Build artifacts. tsbuildinfo is a tsc incremental cache keyed to this machine's
# paths, and the shot-*.png files are output that verify-pwa.mjs regenerates on
# every run; both were tracked, and both only ever produced diff noise.
*.tsbuildinfo
frontend/scripts/shot-*.png
.env
.env.*
!.env.example
.DS_Store
.claude
bakend/.env
# Python
__pycache__/
*.pyc
*.pyd
automation/.env.example
automation/.venv/
automation/reports/

# Android TWA signing key — NEVER commit
android/*.keystore
android/keystore-password.txt
android/.bubblewrap/

# Android TWA � generated by `bubblewrap build` from android/twa-manifest.json.
# Regenerable, and the APK/AAB are 2MB binaries; only the manifest is source.
android/app/
android/build/
android/.gradle/
android/gradle/
android/gradlew
android/gradlew.bat
android/build.gradle
android/settings.gradle
android/gradle.properties
android/store_icon.png
android/manifest-checksum.txt
android/*.apk
android/*.aab
android/*.idsig
android/hs_err_pid*.log

# Supabase CLI scratch state (link info, not secrets)
supabase/.temp/

# Vercel CLI link state (project/org ids) and the env files `vercel pull` writes.
# Added by `vercel link`, which also appended a bare `.env*`; that is dropped
# because the block at the top of this file already covers env files, and does it
# more carefully — it keeps the committed .env.example templates visible.
.vercel
